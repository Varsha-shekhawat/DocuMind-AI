# UNFOLD Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI (AWS Mumbai / ap-south-1)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=UNFOLD

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth cookie attributes
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Google Gemini AI Provider (Free-tier Gemini 2.5 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

