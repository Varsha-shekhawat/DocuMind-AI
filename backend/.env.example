# UNFOLD Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI (AWS Mumbai / ap-south-1)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=UNFOLD

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth cookie attributes
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Local AI Provider (Ollama - Free, private, open-source)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

