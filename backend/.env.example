# UNFOLD Backend Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI (AWS Mumbai / ap-south-1)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=UNFOLD

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Auth cookie attributes. Defaults are derived from NODE_ENV (lax/insecure in
# development, none/secure in production) but can be forced explicitly --
# this matters most when frontend and backend are deployed on different
# domains, where sameSite=none + secure=true is REQUIRED or browsers will
# silently drop the session cookie.
# COOKIE_SAMESITE=lax|none|strict
# COOKIE_SECURE=true|false
COOKIE_SAMESITE=
COOKIE_SECURE=

# AI provider (used for document summary / key points / main ideas / suggestions)
ANTHROPIC_API_KEY=
